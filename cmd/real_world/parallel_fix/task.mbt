///|
/// Result of processing a repository
struct TaskResult {
  /// Repository URL
  repo : String
  /// Whether the task was successful
  success : Bool
  /// Error message if failed
  error : String
  /// Pull request URL if created
  pr_url : String?
  /// Thread ID if agent was used
  thread_id : String?
} derive(Show)

///|
/// Process a single repository with AI agent using two-phase approach
/// This is designed to be idempotent and recoverable - can be re-run safely
async fn process_repository(
  codex : @codex.Codex,
  repo_url : String,
  task_description : String,
  branch_prefix : String,
  work_dir : String,
  force_fresh : Bool,
) -> TaskResult {
  let repo_name = extract_repo_name(repo_url)

  // Clone repository
  let repo = clone_repository(repo_url, work_dir, force_fresh) catch {
    e => @error.reraise(e)
  }

  // Get or create branch (idempotent - reuses existing branch if found)
  let branch_name = get_or_create_branch(repo, branch_prefix) catch {
    e => @error.reraise(e)
  }
  @stdio.stdout.write(
    "info [\{repo_name}] - Working on branch: \{branch_name}\n",
  )

  // Check current state to determine what needs to be done
  let has_unstaged = has_changes(repo) catch { e => @error.reraise(e) }
  let has_staged = has_staged_changes(repo) catch { e => @error.reraise(e) }
  let needs_ai_fix = has_unstaged || !has_staged

  // PHASE 1: AI fixes code (only if needed)
  let thread_id = if needs_ai_fix {
    @stdio.stdout.write(
      "info [\{repo_name}] - Phase 1: AI fixing code in WorkspaceWrite mode...\n",
    )
    let tid = execute_fix_phase(codex, repo, task_description, branch_name) catch {
      e => @error.reraise(e)
    }
    @stdio.stdout.write("info [\{repo_name}] - AI Thread ID: \{tid}\n")
    tid
  } else {
    @stdio.stdout.write(
      "info [\{repo_name}] - Skipping AI phase: changes already staged\n",
    )
    "skipped"
  }

  // Check if there are any changes (unstaged or staged) to process
  let has_unstaged_work = has_changes(repo) catch { e => @error.reraise(e) }
  let has_staged_work = has_staged_changes(repo) catch {
    e => @error.reraise(e)
  }
  let has_work = has_unstaged_work || has_staged_work
  if !has_work {
    @stdio.stdout.write(
      "info [\{repo_name}] - No changes found, task may already be complete\n",
    )
    return TaskResult::{
      repo: repo_url,
      success: true,
      error: "",
      pr_url: None,
      thread_id: if thread_id == "skipped" {
        None
      } else {
        Some(thread_id)
      },
    }
  }

  // TOOL TAKES OVER: Format and commit (idempotent - commits only if needed)
  @stdio.stdout.write(
    "info [\{repo_name}] - Tool taking over: formatting and committing changes...\n",
  )

  // Run format if applicable
  format_repository(repo) catch {
    e =>
      @stdio.stdout.write(
        "warning [\{repo_name}] - Format failed (may not be applicable): \{e}\n",
      )
  }

  // Run update info if applicable
  update_repository_info(repo) catch {
    e =>
      @stdio.stdout.write(
        "warning [\{repo_name}] - Update info failed (may not be applicable): \{e}\n",
      )
  }

  // Commit changes (returns false if nothing to commit)
  let committed = commit_changes(repo, "AI-generated fix: \{task_description}") catch {
    e => @error.reraise(e)
  }
  if !committed {
    @stdio.stdout.write(
      "info [\{repo_name}] - No new changes to commit (may already be committed)\n",
    )
  }

  // PHASE 2: Push and create PR (idempotent)
  @stdio.stdout.write(
    "info [\{repo_name}] - Phase 2: Pushing changes and creating PR...\n",
  )

  // Push branch to remote
  push_branch(repo, branch_name) catch {
    e => @error.reraise(e)
  }

  // Create pull request (will fail gracefully if PR already exists)
  let pr_url = create_pull_request(
    repo,
    branch_name,
    "AI Fix: \{task_description}",
    "This PR was automatically generated by an AI agent.\n\nTask: \{task_description}\n\nThe AI agent fixed the code, and the tool formatted and committed the changes.",
  ) catch {
    e => @error.reraise(e)
  }
  TaskResult::{
    repo: repo_url,
    success: true,
    error: "",
    pr_url,
    thread_id: if thread_id == "skipped" {
      None
    } else {
      Some(thread_id)
    },
  }
}

///|
/// PHASE 1: AI fixes code with WorkspaceWrite sandbox mode
async fn execute_fix_phase(
  codex : @codex.Codex,
  repo : RepoInfo,
  task_description : String,
  branch_name : String,
) -> String {
  let repo_name = repo.name

  // Start fresh thread in WorkspaceWrite mode (safer for code changes)
  @stdio.stdout.write(
    "info [\{repo_name}] - Starting new AI thread (WorkspaceWrite mode)...\n",
  )
  let thread = codex.start_thread(
    options=@codex.ThreadOptions::new(
      working_directory=repo.local_path,
      sandbox_mode=WorkspaceWrite,
    ),
  )

  // Build prompt for fix phase
  let prompt = build_fix_phase_prompt(
    task_description,
    repo_name,
    branch_name,
    repo.default_branch,
  )

  // Execute task with retries
  let mut response = thread.run(prompt) catch { e => @error.reraise(e) }
  let mut attempts = 0
  let max_attempts = 5
  while attempts < max_attempts {
    attempts = attempts + 1
    let tid = thread.id().unwrap_or("unknown")
    @stdio.stdout.write(
      "info [\{repo_name}] - [\{tid}] - Fix phase attempt \{attempts}/\{max_attempts}\n",
    )

    // Check if task is complete
    if response.final_response.contains("TASK COMPLETED") ||
      response.final_response.contains("TASK_COMPLETED") {
      @stdio.stdout.write(
        "info [\{repo_name}] - [\{tid}] - AI completed fix phase\n",
      )
      break
    }

    // Ask agent to continue or fix remaining issues
    @stdio.stdout.write(
      "info [\{repo_name}] - [\{tid}] - Asking agent to continue fixing...\n",
    )
    response = thread.run(
      "Please continue fixing the code. Make sure all errors and warnings are resolved. Run tests to verify. When complete, respond with 'TASK COMPLETED'.",
    ) catch {
      e => @error.reraise(e)
    }
  } else {
    let tid = thread.id().unwrap_or("unknown")
    @stdio.stdout.write(
      "warning [\{repo_name}] - [\{tid}] - Max attempts reached in fix phase\n",
    )
  }
  thread.id().unwrap_or("unknown").to_string()
}

///|
/// Format repository if applicable (e.g., for MoonBit, Python, etc.)
async fn format_repository(repo : RepoInfo) -> Unit {
  let repo_name = repo.name

  // Try moon fmt for MoonBit projects
  if @fs.exists("\{repo.local_path}/moon.mod.json") {
    @stdio.stdout.write("info [\{repo_name}] - Running moon fmt...\n")
    let status = @process.run("moon", ["fmt"], cwd=repo.local_path) catch {
      e => @error.reraise(e)
    }
    if status != 0 {
      @stdio.stdout.write(
        "warning [\{repo_name}] - moon fmt returned non-zero status\n",
      )
    }
  }
  // Could add more formatters here (prettier, black, rustfmt, etc.)
}

///|
/// Update repository info if applicable (e.g., moon info for MoonBit)
async fn update_repository_info(repo : RepoInfo) -> Unit {
  let repo_name = repo.name

  // Try moon info for MoonBit projects
  if @fs.exists("\{repo.local_path}/moon.mod.json") {
    @stdio.stdout.write("info [\{repo_name}] - Running moon info...\n")
    let status = @process.run("moon", ["info"], cwd=repo.local_path) catch {
      e => @error.reraise(e)
    }
    if status != 0 {
      @stdio.stdout.write(
        "warning [\{repo_name}] - moon info returned non-zero status\n",
      )
    }
  }
}

///|
/// Build prompt for PHASE 1 (fix phase with WorkspaceWrite mode)
fn build_fix_phase_prompt(
  task_description : String,
  repo_name : String,
  branch_name : String,
  default_branch : String,
) -> String {
  (
    $|You are an AI agent tasked with fixing issues in the repository: \{repo_name}
    $|
    $|**Task Description**:
    $|\{task_description}
    $|
    $|**Current Branch**: \{branch_name}
    $|**Base Branch**: \{default_branch}
    $|
    $|**Phase 1: Code Fixing (WorkspaceWrite Mode)**
    $|
    $|You are currently in WorkspaceWrite mode, which means you can:
    $|- Read and write files in the workspace
    $|- Execute commands (tests, linters, build tools)
    $|- View git status and diffs
    $|
    $|But you CANNOT:
    $|- Push to remote repositories
    $|- Create pull requests
    $|- Perform other git remote operations
    $|
    $|**Instructions**:
    $|1. Analyze the repository structure and current state
    $|2. Identify and fix all errors and warnings
    $|3. Run all tests to ensure they pass
    $|4. Run linters and fix any linting issues
    $|5. Verify the code builds successfully
    $|6. Make sure the code follows project conventions
    $|7. When all errors/warnings are fixed and tests pass, respond with "TASK COMPLETED"
    $|
    $|**Important**:
    $|- Focus on making the code error-free and test-passing
    $|- Do NOT attempt to commit, push, or create PRs (you don't have permission)
    $|- After you complete, the tool will format and commit your changes
    $|- Then you'll be resumed in a second phase to push the changes
    $|
    $|Begin working on fixing the code now.
  )
}

///|
/// Get current timestamp as string for unique branch names
fn get_timestamp() -> String {
  @async.now().to_string()
}
